---
import BlogTag from '../../../components/blog/BlogTag.astro';
import { loadBlog } from '../../../lib/blog.js';
export async function getStaticPaths() {
  const { tags } = await loadBlog('es');
  return Object.values(tags).filter((t: any) => t.count).map((t: any) => ({ params: { id: t.id } }));
}
const { id } = Astro.params;
---
<BlogTag lang="es" id={id as string} />
