---
// A home page in one language: the head (title, description, JSON-LD for the site and the person) and the content.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Home from './Home.astro';
import { homeGraph } from '../lib/jsonld';
import { pathFor, type Locale } from '../i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const site = (await getEntry('site', 'site'))!.data, L = site[lang];
const title = `${site.name} · ${L.title}`;
const jsonld = await homeGraph(lang, pathFor(lang, 'home'), L.metaDescription);
---
<Base lang={lang} title={title} description={L.metaDescription} route="home" jsonld={jsonld}>
  <Home lang={lang} />
</Base>
