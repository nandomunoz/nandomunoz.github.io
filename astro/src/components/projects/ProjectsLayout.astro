---
// A projects page: the shared chrome plus the blog's styles (the project pages are laid out like a post).
import Base from '../../layouts/Base.astro';
import '../../styles/blog.css';
import '../../styles/projects.css';
import type { Locale, Rest } from '../../i18n/ui';
interface Props { lang: Locale; title: string; description?: string; rest?: Rest; cls?: string }
const { lang, title, description, rest, cls = 'blog' } = Astro.props;
---
<Base lang={lang} title={title} description={description} route="projects" rest={rest} current="projects">
  <div class={cls}><slot /></div>
</Base>
