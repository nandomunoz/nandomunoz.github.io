---
// The home (plan Phase 6): the cover, then the four sections the menu points to.
import '../styles/home.css';
import { getEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import Hero from './home/Hero.astro';
import Bio from './home/Bio.astro';
import Work from './home/Work.astro';
import BlogSection from './home/BlogSection.astro';
import Contact from './home/Contact.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const site = (await getEntry('site', 'site'))!.data, L = site[lang];
const bio = Array.isArray(L.bio) ? L.bio : [L.bio];
---
<Hero lang={lang} name={site.name} kicker={L.kicker} />
<Bio lang={lang} bio={bio} />
<Work lang={lang} />
<BlogSection lang={lang} />
<Contact lang={lang} />
<script>
  import '../scripts/blocks.js';
  import '../scripts/home.js';
  import '../scripts/panel.js';
</script>
