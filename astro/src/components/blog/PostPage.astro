---
// One post (plan Phase 8): breadcrumbs, title, deck, the translation notice, meta, the cover, the table of
// contents (a <details> that is open on a desktop), the body, tags, author, previous and next, related.
import { Picture } from 'astro:assets';
import { render, getEntry } from 'astro:content';
import BlogLayout from './BlogLayout.astro';
import PostList from './PostList.astro';
import { loadBlog, relatedTo, longDate, isoDate, pad } from '../../lib/blog.js';
import { blogStrings, arrows } from '../../i18n/blog.js';
import { pathFor, blogRest, ui, locales, type Locale } from '../../i18n/ui';
import { postGraph, cropped, abs } from '../../lib/jsonld';
interface Props { lang: Locale; slug: string }
const { lang, slug } = Astro.props;
const B = blogStrings(lang), A = arrows(lang), t = ui[lang];
const { posts, categories, tags } = await loadBlog(lang);
const i = posts.findIndex((p) => p.slug === slug);
const post = posts[i], d = post.data, cat = categories[post.category];
const { Content, headings } = await render(post.entry);
const toc = headings.filter((h) => h.depth === 2);
const newer = posts[i - 1], older = posts[i + 1];
const related = relatedTo(post, posts);
const site = (await getEntry('site', 'site'))!.data;
const url = new URL(pathFor(lang, 'blog', blogRest.post(slug)), Astro.site).href;
const href = (p: { slug: string }) => pathFor(lang, 'blog', blogRest.post(p.slug));
const original = pathFor('es', 'blog', blogRest.post(slug));
const here = pathFor(lang, 'blog', blogRest.post(slug));
const jsonld = await postGraph({
  lang, url: here, title: d.title, excerpt: d.excerpt, date: post.date, cover: d.cover.src, section: cat.name, tags: post.tags.map((id: string) => tags[id].label),
  others: locales.filter((l) => l !== lang).map((l) => [l, pathFor(l, 'blog', blogRest.post(slug))] as [Locale, string]), translated: d.translated,
  crumbs: [[site.name, pathFor(lang, 'home')], [B.blog, pathFor(lang, 'blog')], [d.title, here]]
});
const image = { src: await cropped(d.cover.src, 1200, 630), alt: d.cover.alt };
---
<BlogLayout lang={lang} title={`${d.title} · ${site.name}`} description={d.excerpt} rest={blogRest.post(slug)} cls="blog post" image={image} ogType="article" jsonld={jsonld}>
  <header class="post__head">
    <p class="crumbs"><a href={pathFor(lang, 'blog')}>{B.blog}</a><span aria-hidden="true"> / </span><a href={pathFor(lang, 'blog', blogRest.category(cat.id))}>{cat.name}</a></p>
    <h1 class="post__title">{d.title}</h1>
    <p class="post__deck">{d.excerpt}</p>
    {d.translated && <p class="post__banner" role="note"><span>{B.autoNote}</span> <a href={original} hreflang="es">{B.autoLink}</a></p>}
    <dl class="post__meta">
      <div><dt>{B.published}</dt><dd><time datetime={isoDate(post.date)}>{longDate(lang, post.date)}</time></dd></div>
      <div><dt>{B.reading}</dt><dd>{B.min(post.minutes)}</dd></div>
    </dl>
  </header>
  <figure class="post__cover">
    <div class="cover-screen">
      <Picture src={d.cover.src} alt={d.cover.alt} widths={[640, 1100, 1600, 2000]} sizes="(min-width: 64em) 70vw, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" decoding="async" />
    </div>
    {d.cover.credit && <figcaption class="post__credit" lang="es" set:html={d.cover.credit} />}
  </figure>
  <div class="post__grid">
    <aside class="post__side">
      {toc.length > 1 && (
        <details class="toc" data-open-wide>
          <summary>{B.toc}</summary>
          <ol>{toc.map((h, k) => <li><a href={'#' + h.slug}><span class="toc__n" aria-hidden="true">{pad(k + 1)}</span><span>{h.text}</span></a></li>)}</ol>
        </details>
      )}
      <div class="share">
        <button type="button" class="share__btn" aria-haspopup="dialog" data-share data-url={url} data-title={d.title} data-text={d.excerpt} hidden><span>{B.shareThis}</span></button>
      </div>
    </aside>
    <div class="post__main">
      <div class="prose" data-new-tab={t.newTab} data-anchor={B.sectionLink}><Content /></div>
      <ul class="tags" aria-label={B.tags}>{post.tags.map((id) => <li><a href={pathFor(lang, 'blog', blogRest.tag(id))}>#{tags[id].label}</a></li>)}</ul>
      <section class="author" aria-label={B.by}>
        <p class="author__by">{B.by}</p>
        <p class="author__name">{site.name}</p>
        <p class="author__kicker">{site[lang].kicker}</p>
        <p class="author__links"><a href={pathFor(lang, 'home') + '#bio'}>{B.authorMore}</a><a href={pathFor(lang, 'home') + '#contacto'}>{B.write}</a></p>
      </section>
    </div>
  </div>
  <nav class="post__nav" aria-label={B.blog}>
    {newer ? <a href={href(newer)} rel="prev"><span class="post__dir">{A.prev} {B.newerPost}</span><span class="post__to">{newer.data.title}</span></a> : <span></span>}
    {older ? <a href={href(older)} rel="next"><span class="post__dir">{B.olderPost} {A.next}</span><span class="post__to">{older.data.title}</span></a> : <span></span>}
  </nav>
  {related.length > 0 && (
    <section class="related" aria-labelledby="rel-title">
      <h2 id="rel-title" class="related__title">{B.related}</h2>
      <PostList lang={lang} posts={related} categories={categories} group={false} />
    </section>
  )}
  <div class="progress" aria-hidden="true"><i></i></div>

  <dialog class="share__dialog" aria-labelledby="share-title" data-share-dialog>
    <div class="share__head">
      <h2 class="share__title" id="share-title">{B.shareThis}</h2>
      <form method="dialog"><button class="share__close"><span>{B.close}</span><span aria-hidden="true"> ×</span></button></form>
    </div>
    <p class="share__what">{d.title}</p>
    <label class="share__field-label" for="share-url">{B.shareLink}</label>
    <div class="share__copy">
      <input class="share__url" id="share-url" type="text" readonly value={url}>
      <button type="button" class="share__btn share__copybtn" data-copy><span>{B.copy}</span></button>
    </div>
    <p class="share__status" role="status" data-copied={B.copied} data-copyfail={B.copyFail}></p>
    <p class="share__field-label" id="share-on">{B.shareOn}</p>
    <ul class="share__places" aria-labelledby="share-on">
      {[['WhatsApp', `https://wa.me/?text=${encodeURIComponent(d.title)}%20${encodeURIComponent(url)}`], ['X (Twitter)', `https://twitter.com/intent/tweet?text=${encodeURIComponent(d.title)}&url=${encodeURIComponent(url)}`], ['Telegram', `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}`], ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`], ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`], ['Bluesky', `https://bsky.app/intent/compose?text=${encodeURIComponent(d.title)}%20${encodeURIComponent(url)}`]].map(([name, h]) => (
        <li><a href={h} target="_blank" rel="noopener"><span>{name}</span><span class="vh"> {t.newTab}</span><span aria-hidden="true"> ↗</span></a></li>
      ))}
      <li><a href={`mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(url)}`}>{B.email}</a></li>
    </ul>
  </dialog>
</BlogLayout>
<script>
  import '../../scripts/post.js';
  import '../../scripts/video.js';
</script>
