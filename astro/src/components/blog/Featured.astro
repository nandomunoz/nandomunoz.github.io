---
// The latest post, big, at the top of the blog's first page.
import { Picture } from 'astro:assets';
import { pathFor, blogRest, type Locale } from '../../i18n/ui';
import { blogStrings } from '../../i18n/blog.js';
import { longDate, isoDate } from '../../lib/blog.js';
interface Props { lang: Locale; post: any; categories: Record<string, { id: string; name: string; kind?: number }> }
const { lang, post, categories } = Astro.props;
const B = blogStrings(lang), cat = categories[post.category];
const loop = { rows: 30, density: post.density, kind: cat.kind, seed: post.seed, label: '', tone: post.data.cover.tone?.src, narrow: { rows: 22 } };
---
<article class="feat">
  <div class="feat__dots cover-loop is-rest">
    <Picture src={post.data.cover.src} alt="" widths={[640, 1100, 1600]} sizes="(min-width: 64em) 70vw, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" decoding="async" />
    <canvas aria-hidden="true" data-loop={JSON.stringify(loop)}></canvas>
  </div>
  <div class="feat__text">
    <p class="feat__kicker"><span>{B.latest}</span> · <a href={pathFor(lang, 'blog', blogRest.category(cat.id))}>{cat.name}</a></p>
    <h2 class={post.data.title.length > 48 ? 'feat__title feat__title--long' : 'feat__title'}><a href={pathFor(lang, 'blog', blogRest.post(post.slug))}>{post.data.title}</a></h2>
    <p class="feat__excerpt">{post.data.excerpt}</p>
    <p class="feat__meta"><time datetime={isoDate(post.date)}>{longDate(lang, post.date)}</time> · {B.min(post.minutes)}</p>
  </div>
</article>
