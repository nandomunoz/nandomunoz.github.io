---
// /blog/categoria/ — every category with a sample of its screen.
import BlogLayout from './BlogLayout.astro';
import BlogHead from './BlogHead.astro';
import { loadBlog } from '../../lib/blog.js';
import { blogStrings } from '../../i18n/blog.js';
import { pathFor, blogRest, type Locale } from '../../i18n/ui';
import { getEntry } from 'astro:content';
interface Props { lang: Locale }
const { lang } = Astro.props;
const B = blogStrings(lang);
const { posts, categories } = await loadBlog(lang);
const list = Object.values(categories);
const name = (await getEntry('site', 'site'))!.data.name;
---
<BlogLayout lang={lang} title={`${B.categories} · Blog · ${name}`} description={B.categoriesDeck} rest={blogRest.categories()}>
  <BlogHead note={B.listNote} crumbs={[[B.blog, pathFor(lang, 'blog')]]} title={B.categories} count={`${list.length} · ${B.countOne(posts.length)}`} />
  <aside class="legend"><h3>{B.legendTitle}</h3><p>{B.legend}</p></aside>
  <ul class="cats">
    {list.map((k) => (
      <li class="cat">
        <div class="cat__dots"><canvas data-dots={JSON.stringify({ rows: 12, density: 0.75, kind: k.kind, seed: 31 + k.kind })} aria-hidden="true"></canvas></div>
        <h2 class="cat__name"><a href={pathFor(lang, 'blog', blogRest.category(k.id))}>{k.name}</a></h2>
        <p class="cat__desc">{k.desc}</p>
        <p class="cat__count">{B.countOne(k.count)}</p>
      </li>
    ))}
  </ul>
</BlogLayout>
<script>import '../../scripts/blocks.js';</script>
