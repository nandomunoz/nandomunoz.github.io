---
// The head of a blog page: breadcrumbs (or the section number), the title, a deck, a note and a count.
interface Props { crumbs?: [string, string][]; title: string; deck?: string; note?: string; count?: string; n?: string }
const { crumbs = [], title, deck, note, count, n = '03' } = Astro.props;
---
<header class="bhead">
  {crumbs.length
    ? <p class="crumbs">{crumbs.map(([label, href], i) => <>{i > 0 && <span aria-hidden="true"> / </span>}<a href={href}>{label}</a></>)}</p>
    : <p class="sec-head__n" aria-hidden="true">{n}</p>}
  <h1 class:list={['bhead__title', { decode: title.length <= 24 }]}>{title}</h1>
  {deck && <p class="bhead__deck">{deck}</p>}
  {note && <p class="bhead__note" role="note">{note}</p>}
  {count && <p class="bhead__count">{count}</p>}
</header>
