---
// A stand-in for the home until Phase 6: the four sections the menu points to, tall enough to scroll.
import { getEntry } from 'astro:content';
import { ui, type Locale } from '../i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const site = (await getEntry('site', 'site'))!.data;
---
<section class="hero"><div class="hero__copy"><h1>{t.siteName}</h1><p>{site[lang].kicker}</p></div></section>
<section id="bio"><h2>{t.bio}</h2></section>
<section id="trabajo"><h2>{t.work}</h2></section>
<section id="blog"><h2>{t.blog}</h2></section>
<section id="contacto"><h2>{site[lang].contactTitle}</h2></section>
<style>
  section { min-block-size: 100vh; padding: 8rem var(--gut) 4rem; }
  .hero { padding-block-start: 10rem; }
</style>
